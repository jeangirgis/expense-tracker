# Google Sheet ID (from the Sheet URL)
# Example: https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Path inside the container (mounted via Docker volume)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/service-account.json

# Flask secret key (change this in production)
APP_SECRET_KEY=change-me-in-production

# Port (optional, default 5000)
APP_PORT=5000
